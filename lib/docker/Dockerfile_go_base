## build
FROM golang:1.24.12-bookworm AS go_base
ARG TARGETARCH
WORKDIR /app

# ENV GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=direct
COPY go.mod go.sum ./
# No cache mount - bake modules into image layer for child images
RUN go mod download

# Tools use cache mount for build cache only - binaries go to GOPATH/bin
RUN --mount=type=cache,target=/root/.cache/go-build,id=${TARGETARCH} \
    go install honnef.co/go/tools/cmd/staticcheck@2024.1.1 & \
    go install github.com/securego/gosec/v2/cmd/gosec@v2.21.4 & \
    wait

FROM go_base AS go_eks_base
FROM go_base AS go_lambda_base
